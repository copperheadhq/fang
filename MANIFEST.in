# The sdist carries what a source consumer needs to run the suite and read the
# contract: the tests, the examples they exercise, and the spec under openspec/.
include CHANGELOG.md
include RELEASING.md
include CLAUDE.md
graft tests
graft examples
graft openspec
prune site
prune packages
exclude package.json
exclude package-lock.json
prune .claude
prune .github
global-exclude *.py[cod]
global-exclude .DS_Store
