{
  "name": "@copperhead/starlight-theme",
  "version": "0.1.0",
  "description": "The copperhead theme for Starlight: tokens, faces, component overrides, and code-block styling.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "astro",
    "starlight",
    "starlight-plugin",
    "theme",
    "copperhead"
  ],
  "exports": {
    ".": "./index.ts",
