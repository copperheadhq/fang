    "env.d.ts",
    "styles",
    "components",
    "assets",
    "README.md"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41.0 <0.42.0",
    "@fontsource-variable/inter": "^5.0.0",
